# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pricecompt
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=dev-secret-key-change-in-production-abc123
JWT_EXPIRES_IN=7d

# Email (for price drop alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Image upload directory
UPLOAD_DIR=uploads
